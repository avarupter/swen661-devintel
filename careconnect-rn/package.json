{
  "name": "careconnect-rn",
  "version": "1.0.0",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --go",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@react-native-vector-icons/ionicons": "^13.1.4",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/elements": "^2.9.26",
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.6",
    "expo": "^56.0.12",
    "expo-asset": "~56.0.17",
    "expo-dev-client": "~56.0.20",
    "expo-linking": "~56.0.14",
    "expo-splash-screen": "~56.0.10",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "12.4.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "jest-html-reporters": "^3.1.7",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/**/*.d.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 60,
        "statements": 60
      }
    },
    "reporters": [
      "default",
      [
        "jest-html-reporters",
        {
          "publicPath": "./html-report",
          "filename": "report.html",
          "openReport": false
        }
      ]
    ]
  },
  "overrides": {
    "react-server-dom-webpack": {
      "react": "$react",
      "react-dom": "$react"
    }
  },
  "private": true
}