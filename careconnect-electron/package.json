{
  "name": "careconnect-electron",
  "productName": "CareConnect",
  "version": "1.0.0",
  "description": "CareConnect clinical workspace: Electron + React desktop app",
  "license": "ISC",
  "author": "DevIntel",
  "private": true,
  "type": "commonjs",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:docker": "npm run build && bash scripts/build-win-docker.sh",
    "test:e2e": "electron-vite build && jest -c jest.e2e.config.cjs",
    "dist": "npm run build && electron-builder",
    "dev:web": "vite --config vite.web.config.ts",
    "test:axe": "node scripts/axe-scan.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6"
  }
}
