# Test coverage output
coverage

# The repo root ignores **/vite.config.js and **/package-lock.json — patterns
# inherited from the Flutter and React Native projects alongside this one.
# Both files are load-bearing here: without vite.config.js a clone has no React
# plugin and no relative base and cannot build for GitHub Pages, and without the lockfile an
# install is not reproducible. A .gitignore nearer the file wins over one in a
# parent directory, so these two negations rescue them without touching the
# shared root file.
!vite.config.js
!package-lock.json

# Playwright output (the HTML report and traces). The evidence PNGs the team
# document uses are committed under docs/evidence/ instead.
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Lighthouse's chrome-launcher, run under WSL, puts its temporary Chrome profile
# at a Windows-style path relative to the working directory, which creates
# folders literally named "C:\Users\…\lighthouse.XXXXXX" here. Never commit them.
/C:*
