# CareConnect — environment variable template
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# The real .env is gitignored and must NEVER be committed.

# ── Supabase (client-side) ──────────────────────────────────────────────────
# Exposed to the browser via Vite's VITE_ prefix. The anon key is a public key
# protected by Row-Level Security, but still configure it per-environment.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Anthropic (SERVER-SIDE ONLY) ────────────────────────────────────────────
# Used by the Supabase edge function (supabase/functions/chat-assistant).
# Do NOT prefix this with VITE_ — anything prefixed with VITE_ is bundled into
# the client and would leak the key to the browser. Keep it server-side only.
ANTHROPIC_API_KEY=your_anthropic_api_key
